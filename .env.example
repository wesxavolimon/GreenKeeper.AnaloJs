# Copie para .env (nunca commitar o .env). Apenas valores PUBLICOS: tudo com prefixo VITE_ vai para o bundle.

# development | test | production
# Em production o override de dispositivo (?mobilePreview=1) e IGNORADO.
VITE_APP_ENV=development

