{
  "name": "greenkeeper-analojs",
  "version": "0.1.0",
  "description": "GreenKeeper PWA em AnalogJS, sem backend proprio, exclusivo para celular",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite --host 0.0.0.0",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --outDir dist/analog/public --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:screenshots": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "^2.9.7",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.7",
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@analogjs/vitest-angular": "^2.9.7",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^22.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
